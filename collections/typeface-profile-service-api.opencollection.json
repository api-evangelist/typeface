{
  "opencollection": "1.0.0",
  "info": {
    "name": "Typeface Audiences Profile Service API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile Service",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-us.typeface.ai/profile-service/accounts/:accountId/workflows",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the list of workflows associated with a specific account."
        },
        {
          "info": {
            "name": "Get Workflow Steps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-us.typeface.ai/profile-service/accounts/:accountId/workflows/:workflowId/workflow-steps",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "workflowId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the steps/statuses of a specific workflow."
        }
      ]
    }
  ],
  "bundled": true
}