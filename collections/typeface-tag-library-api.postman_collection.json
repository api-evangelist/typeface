        {
          "id": "b454fe59-d8b5-4173-b814-e746408a4bb2",
          "name": "Create Tags",
          "request": {
            "name": "Create Tags",
            "description": {
              "content": "Creates one or more tags in a single request. Each tag in the request is processed independently, so some tags may succeed while others fail. The response contains a per-item result for every tag in the request, each marked with `success: true` or `success: false`.\n\nFor each tag, provide a `name` and `displayName`. Optionally include `parentId` to nest the tag under an existing parent, and `properties` to attach metadata such as `description`. Tags without a `parentId` are created as top-level tags.\n\nThe top-level `success` field in the response is `true` only when every tag was created successfully. If any tag fails, `success` is `false` (partial success).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "profile-service",
                "accounts",
                ":accountId",
                "tags"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountId",
                  "description": "(Required) Unique identifier for the account"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\n    {\n      \"name\": \"<string>\",\n      \"displayName\": \"<string>\",\n      \"parentId\": \"<long>\",\n      \"description\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"displayName\": \"<string>\",\n      \"parentId\": \"<long>\",\n      \"description\": \"<string>\"\n    }\n  ]\n}",
              "options": {
